@model IEnumerable<Participant>
@{
    ViewData["Title"] = "Registered Participants";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">Registered Participants</h1>
        <p class="text-muted">AMTICS Technical Fest registration list.</p>
    </div>
    <div>
        <a class="btn btn-primary me-2" asp-action="Register">Register</a>
        <a class="btn btn-outline-dark" asp-action="Welcome">Welcome</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-warning">No participants have registered yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Year</th>
                            <th>Event</th>
                            <th>Status</th>
                            <th>Fee</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var participant in Model)
                    {
                        var status = participant.GetRegistrationStatus();
                        <tr>
                            <td>@participant.ParticipantId</td>
                            <td>@participant.ParticipantName</td>
                            <td>@participant.Email</td>
                            <td>@participant.Department</td>
                            <td>@participant.Year</td>
                            <td>@participant.EventName</td>
                            <td>
                                @if (status == "Confirmed")
                                {
                                    <span class="badge bg-success">@status</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@status</span>
                                }
                            </td>
                            <td>
                                ₹@participant.GetRegistrationFee().ToString("0.00")
                                <small class="d-block text-muted">@participant.GetFeeCategory()</small>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Details" asp-route-id="@participant.ParticipantId">Details</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
