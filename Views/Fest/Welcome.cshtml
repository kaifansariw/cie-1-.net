@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center py-5">
    <div class="card shadow-lg border-0">
        <div class="card-body p-5">
            <h1 class="display-4 fw-bold">Welcome to the AMTICS Technical Fest!</h1>
            <p class="lead mt-3">
                Explore exciting technical events, showcase your skills, and compete with fellow students.
            </p>
            <p class="text-muted">
                Register today and become a part of our college's technical celebration.
            </p>

            <div class="mt-4">
                <a class="btn btn-primary btn-lg me-2" asp-action="Register">Register Now</a>
                <a class="btn btn-outline-dark btn-lg" asp-action="Index">View Participants</a>
            </div>
        </div>
    </div>
</div>
