<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - College Technical Fest</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Fest" asp-action="Index">AMTICS Tech Fest</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" asp-controller="Fest" asp-action="Index">Participants</a>
                <a class="nav-link" asp-controller="Fest" asp-action="Register">Register</a>
                <a class="nav-link" asp-controller="Fest" asp-action="Welcome">Welcome</a>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

       <footer class="text-center text-muted py-3">
        <small>AMTICS College Technical Fest &copy; @DateTime.Now.Year</small>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
